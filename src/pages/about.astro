---
/**
 * Sobre mí, en inglés. Ruta: /about
 * Su pareja en español es src/pages/es/sobre-mi.astro.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import AboutIntro from '@components/AboutIntro.astro';
import johannaAbout from '@assets/photos/johanna-about.jpeg';

const locale = 'en' as const;
const entry = await getEntry('pages', 'en/about');
if (!entry) throw new Error('Falta src/content/pages/en/about.md');

const { Content } = await render(entry);
const { title, description, heading, subheading, eyebrow } = entry.data;
---

<BaseLayout locale={locale} page="about" title={title} description={description}>
  <Hero
    locale={locale}
    heading={heading}
    subheading={subheading}
    eyebrow={eyebrow}
    variant="page"
  />

  <AboutIntro photo={johannaAbout} photoAlt="Johanna Bellorín, LCSW">
    <Content />
  </AboutIntro>
</BaseLayout>
