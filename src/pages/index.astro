---
/**
 * Home en inglés. Ruta: /
 *
 * Las secciones van en el orden que fija el ritmo de color del diseño, que es
 * parte del encanto de la maqueta aprobada:
 *
 *   hero (degradado) → vídeo (cielo) → servicios (crema) →
 *   pagos (savia) → FAQ (crema) → CTA (cielo) → pie (cristal)
 *
 * Cada sección es un resumen que enlaza a su página completa. NO copiar aquí
 * el contenido de las subpáginas: sería contenido duplicado a efectos de SEO y
 * el doble de mantenimiento en dos idiomas.
 *
 * Su pareja en español es src/pages/es/index.astro. Los dos archivos deben
 * tener la misma estructura de secciones.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import VideoIntro from '@components/VideoIntro.astro';
import ServicesGrid from '@components/ServicesGrid.astro';
import PaymentPaths from '@components/PaymentPaths.astro';
import FaqSection from '@components/FaqSection.astro';
import CtaBand from '@components/CtaBand.astro';

const locale = 'en' as const;
const entry = await getEntry('pages', 'en/home');
if (!entry) throw new Error('Falta src/content/pages/en/home.md');

const { Content } = await render(entry);
const { title, description, heading, subheading, eyebrow, traits, quote, sections } = entry.data;
if (!sections) throw new Error('La home necesita el bloque `sections` en su frontmatter');
---

<BaseLayout locale={locale} page="home" title={title} description={description}>
  <Hero
    locale={locale}
    variant="home"
    heading={heading}
    subheading={subheading}
    eyebrow={eyebrow}
    traits={traits}
  >
    <Content />
  </Hero>

  <VideoIntro locale={locale} quote={quote} />

  <ServicesGrid
    locale={locale}
    eyebrow={sections.services.eyebrow}
    heading={sections.services.heading}
    intro={sections.services.intro}
  />

  <PaymentPaths
    locale={locale}
    eyebrow={sections.fees.eyebrow}
    heading={sections.fees.heading}
    intro={sections.fees.intro}
  />

  <FaqSection
    locale={locale}
    eyebrow={sections.faq.eyebrow}
    heading={sections.faq.heading}
  />

  <CtaBand
    locale={locale}
    eyebrow={sections.cta.eyebrow}
    heading={sections.cta.heading}
    body={sections.cta.intro}
  />
</BaseLayout>
