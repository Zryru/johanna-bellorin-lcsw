---
/**
 * Sobre mí, en español. Ruta: /es/sobre-mi
 *
 * El archivo de contenido se llama `about.md`, no `sobre-mi.md`: los nombres
 * de archivo son canónicos en inglés aunque la URL esté traducida. El mapa de
 * slugs está en src/i18n/routes.ts.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import AboutIntro from '@components/AboutIntro.astro';
import johannaAbout from '@assets/photos/johanna-about.jpeg';

const locale = 'es' as const;
const entry = await getEntry('pages', 'es/about');
if (!entry) throw new Error('Falta src/content/pages/es/about.md');

const { Content } = await render(entry);
const { title, description, heading, subheading, eyebrow } = entry.data;
---

<BaseLayout locale={locale} page="about" title={title} description={description}>
  <Hero
    locale={locale}
    heading={heading}
    subheading={subheading}
    eyebrow={eyebrow}
    variant="page"
  />

  <AboutIntro photo={johannaAbout} photoAlt="Johanna Bellorín, LCSW">
    <Content />
  </AboutIntro>
</BaseLayout>
