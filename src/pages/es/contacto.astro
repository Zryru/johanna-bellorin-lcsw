---
/**
 * Contacto, en español. Ruta: /es/contacto
 * Archivo de contenido: contact.md (nombre canónico en inglés).
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import ContactSection from '@components/ContactSection.astro';

const locale = 'es' as const;
const entry = await getEntry('pages', 'es/contact');
if (!entry) throw new Error('Falta src/content/pages/es/contact.md');

const { Content } = await render(entry);
const { title, description, heading, subheading, eyebrow } = entry.data;
---

<BaseLayout locale={locale} page="contact" title={title} description={description}>
  <Hero
    locale={locale}
    heading={heading}
    subheading={subheading}
    eyebrow={eyebrow}
    variant="page"
  >
    <Content />
  </Hero>

  <ContactSection locale={locale} />
</BaseLayout>
